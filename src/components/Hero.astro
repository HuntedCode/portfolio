---
const links = {
  github: "https://github.com/HuntedCode",
  email: "jeffrey.lowe.dev@gmail.com",
  resumeFullStack: "/resume-fullstack.pdf",
  resumePython: "/resume-python.pdf",
};

const stack = [
  { name: "Python", href: "https://www.python.org" },
  { name: "Django", href: "https://www.djangoproject.com" },
  { name: "FastAPI", href: "https://fastapi.tiangolo.com" },
  { name: "PostgreSQL", href: "https://www.postgresql.org" },
  { name: "React Native", href: "https://reactnative.dev" },
  { name: "Tailwind", href: "https://tailwindcss.com" },
  { name: "Redis", href: "https://redis.io" },
];
---

<section class="relative isolate overflow-hidden">
  <div
    class="absolute inset-x-0 top-0 -z-10 h-[600px] bg-gradient-to-b from-cyan-500/[0.07] via-cyan-500/[0.02] to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-5xl px-6 py-20 lg:py-32">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-10 lg:gap-16 items-center">

      <div class="order-2 lg:order-1">
        <p class="font-mono text-xs tracking-[0.2em] uppercase text-cyan-400 mb-5 flex items-center gap-2">
          <span class="relative inline-flex w-2 h-2">
            <span class="absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75 animate-ping"></span>
            <span class="relative inline-flex w-2 h-2 rounded-full bg-cyan-400 shadow-[0_0_12px_var(--color-cyan-400)]"></span>
          </span>
          Available for hire
        </p>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-slate-100">
          Jeffrey Lowe
        </h1>

        <p class="mt-3 text-xl md:text-2xl text-slate-300 font-medium">
          <span class="text-cyan-400">Full-Stack</span> &amp; <span class="text-cyan-400">Python</span> Developer
        </p>

        <p class="mt-6 text-base md:text-lg text-slate-400 max-w-xl leading-relaxed">
          I designed, shipped, and maintain a production Django web app end to end, solo. Plus a companion Python bot service and a React Native mobile app, both in active development. Self-taught and looking for my first developer role.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={links.resumeFullStack}
            class="group inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-cyan-400 text-slate-950 font-semibold text-sm shadow-md shadow-cyan-500/20 hover:bg-cyan-300 hover:shadow-lg hover:shadow-cyan-400/30 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 transition-all duration-200"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
            Resume (Full-Stack)
          </a>
          <a
            href={links.resumePython}
            class="group inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-slate-900 border border-slate-700 text-slate-100 font-semibold text-sm hover:border-cyan-400 hover:text-cyan-400 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 transition-all duration-200"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
            Resume (Python)
          </a>
          <a
            href={links.github}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-slate-900 border border-slate-700 text-slate-100 font-semibold text-sm hover:border-cyan-400 hover:text-cyan-400 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 transition-all duration-200"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.05-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.4 1.24-3.24-.12-.3-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 016 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.77.84 1.24 1.92 1.24 3.24 0 4.63-2.81 5.65-5.49 5.95.43.37.81 1.1.81 2.22 0 1.6-.01 2.89-.01 3.28 0 .32.22.7.83.58A12 12 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            GitHub
          </a>
          <a
            href={`mailto:${links.email}`}
            class="group inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-slate-900 border border-slate-700 text-slate-100 font-semibold text-sm hover:border-cyan-400 hover:text-cyan-400 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 transition-all duration-200"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            Email
          </a>
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-xs text-slate-500">
          {stack.map((tech, i) => (
            <>
              {i > 0 && <span class="text-slate-700" aria-hidden="true">/</span>}
              <a
                href={tech.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${tech.name} documentation`}
                class="hover:text-cyan-400 focus-visible:text-cyan-400 focus-visible:outline-none transition-colors"
              >
                {tech.name}
              </a>
            </>
          ))}
        </div>
      </div>

      <div class="order-1 lg:order-2 parallax-up">
        <div class="group relative w-40 h-40 md:w-52 md:h-52 lg:w-64 lg:h-64 rounded-2xl overflow-hidden bg-slate-900 border-2 border-slate-800 shadow-xl shadow-cyan-500/10 hover:border-cyan-400/40 hover:shadow-cyan-500/20 transition-all duration-300">
          <img
            src="/profile.jpg"
            alt="Jeffrey Lowe"
            width="400"
            height="400"
            fetchpriority="high"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
          />
          <div class="absolute inset-0 ring-1 ring-inset ring-white/[0.06] rounded-2xl pointer-events-none"></div>
        </div>
      </div>

    </div>
  </div>
</section>
